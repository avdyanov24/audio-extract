# Copy to .env and fill in. Never commit .env.
# Every value here is optional — the app runs with sensible defaults.

# Port for the Express API. The Vite dev server proxies /api to this.
PORT=

# Interface to bind. Leave as-is; this tool is not built for public exposure.
HOST=

# Minutes a finished file stays on disk before it is deleted.
FILE_TTL_MINUTES=

# Absolute path to a Netscape-format cookies.txt, passed to yt-dlp as
# --cookies. Only needed for age-restricted videos. Path only, never contents.
YTDLP_COOKIES=
