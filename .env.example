# Copy to .env and fill in. Never commit .env.
# Every value here is optional — the app runs with sensible defaults.

# --- Server ---

# Port for the Express API. The Vite dev server proxies /api to this.
PORT=

# Interface to bind. Defaults to 127.0.0.1. Only widen this when the instance
# sits behind auth and something else controls who can reach it.
HOST=

# Minutes a finished file stays on disk before it is deleted.
FILE_TTL_MINUTES=

# --- Access control ---
# Unset means no authentication, which is the right default on localhost and
# the wrong one anywhere else. When set, every API route requires the token.
AUTH_TOKEN=

# Set to "false" to drop the Secure flag on the auth cookie. Only needed when
# testing auth over plain http on a non-localhost address.
COOKIE_SECURE=

# --- Limits ---
# Defaults shown. Each one only matters once the instance is reachable by
# someone other than you.

# Simultaneous extractions. ffmpeg saturates whatever cores it is given.
MAX_CONCURRENT_JOBS=

# Reject sources longer than this before any work starts.
MAX_DURATION_MINUTES=

# Refuse new jobs while retained files exceed this. WAV runs ~11 MB per minute.
MAX_DISK_MB=

# Fixed-window rate limit on the endpoints that spawn work.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# --- YouTube cookies ---
# Needed for age-restricted videos, and in practice for any hosted deployment,
# because YouTube bot-checks datacenter IPs.

# Absolute path to a Netscape-format cookies.txt. Path only, never contents.
YTDLP_COOKIES=

# The file's contents, for hosts that expose secrets as environment variables
# rather than files. Written to a 0600 temp file at startup. Ignored when
# YTDLP_COOKIES is set.
YTDLP_COOKIES_CONTENT=
